# Copier ce fichier en .env.local et remplir les valeurs. Ne jamais commiter .env.local.
# Sur Vercel, mettre les mêmes variables dans Settings > Environment Variables.

# Base Postgres (Neon). Vercel > Storage > ta base > .env.local
DATABASE_URL=
# Connexion directe, sans pooler, pour les migrations (npm run db:migrate)
DATABASE_URL_UNPOOLED=

# Better Auth. Une valeur aléatoire longue, différente en local et en ligne :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# L'adresse du site : http://localhost:3000 en local, l'URL Vercel en ligne
BETTER_AUTH_URL=

# Mot de passe des deux comptes démo. Le seed s'en sert pour créer les comptes,
# les boutons « Entrer comme… » pour se connecter. Même valeur aux deux endroits.
DEMO_PASSWORD=

# Photos produits (Vercel Blob, accès public). Vercel > Storage > ton espace Blob > .env.local
BLOB_READ_WRITE_TOKEN=
